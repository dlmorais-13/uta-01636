{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Python Debugger: App & Job",
            "configurations": ["Python Debugger: App", "Python Debugger: Job"],
            "stopAll": true,
            "presentation": {
                "hidden": false,
                "group": "dev",
                "order": 1
            }
        }
    ],
    "configurations": [
        {
            "name": "Python Debugger: Current file as module",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "${command:extension.commandvariable.file.relativeDirDots}.${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}",
            "env": {
                "DEBUG": "True"
            },
            "justMyCode": false,
            "autoReload": {
                "enable": true,
                "include": [
                    "**/*.py"
                ]
            }
        },
        {
            "name": "Python Debugger: App",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "src.main",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "autoReload": {
                "enable": true,
                "include": [
                    "**/*.py"
                ]
            }
        },
        {
            "name": "Python Debugger: Job",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "src.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "JOB_MANAGER_ID": "1",
                "JOB_POLLING_TIME": "5"
            },
            "justMyCode": false,
            "autoReload": {
                "enable": true,
                "include": [
                    "**/*.py"
                ]
            }
        }
    ]
}