{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current file as module",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "${command:extension.commandvariable.file.relativeDirDots}.${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}",
            "env": {
                "DEBUG": "True",
                "LOG_FILE": "True",
                "JOB_MANAGER_ID": "1",
                "JOB_POLLING_TIME": "5",
                "EXECUTOR_MOD": "3",
                "EXECUTOR_QTY": "10",
                "EXECUTOR_LIMIT": "1",
                "EXECUTOR_MODE": "reprocess"
                // "EXECUTOR_MODE": "all"
                // "EXECUTOR_MODE": "equilibrium"
                // "EXECUTOR_MODE": "base"
                // "EXECUTOR_MODE": "simulation"
            },
            "justMyCode": false,
            "autoReload": {
                "enable": true,
                "include": [
                    "**/*.py"
                ]
            }
        },
        {
            "name": "Python Debugger: Job",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "src.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "JOB_MANAGER_ID": "1",
                "JOB_POLLING_TIME": "5",
                "DEBUG": "True",
                "LOG_FILE": "True"
            },
            "justMyCode": false,
            "autoReload": {
                "enable": true,
                "include": [
                    "**/*.py"
                ]
            }
        }
    ]
}